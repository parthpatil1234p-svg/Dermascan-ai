RECOMMENDATION_MIN_DISPLAY_SCORE=60
RECOMMENDATION_MAX_PER_CATEGORY=2
RECOMMENDATION_MAX_SAME_BRAND=2
REPORT_EXPORT_DIRECTORY=storage/temp_report_exports
REPORT_EXPORT_EXPIRY_MINUTES=30
REPORT_PDF_INCLUDE_PROFILE_DETAILS=true
REPORT_PDF_INCLUDE_TECHNICAL_DETAILS=false
FEEDBACK_MAX_SUBMISSIONS_PER_HOUR=20
FEEDBACK_DUPLICATE_WINDOW_SECONDS=60
FEEDBACK_MAX_COMMENT_LENGTH=1000
FEEDBACK_ANALYTICS_MIN_GROUP_SIZE=3
