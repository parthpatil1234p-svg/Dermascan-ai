APP_NAME=DermaScan AI
APP_ENV=development
API_PREFIX=/api
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=dermascan_ai
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
ENABLE_HSTS=false
AI_DEMO_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_ANALYSIS=30
RATE_LIMIT_PDF_EXPORT=10
RATE_LIMIT_FEEDBACK=20
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png
UPLOAD_DIRECTORY=storage/temp_uploads
TEMP_UPLOAD_EXPIRY_MINUTES=30
IMAGE_MIN_WIDTH=300
IMAGE_MIN_HEIGHT=300
IMAGE_MAX_WIDTH=6000
IMAGE_MAX_HEIGHT=6000
BLUR_FAIL_THRESHOLD=60
BLUR_WARNING_THRESHOLD=110
BRIGHTNESS_MIN_FAIL=45
BRIGHTNESS_MIN_WARNING=75
BRIGHTNESS_MAX_WARNING=200
BRIGHTNESS_MAX_FAIL=225
MIN_CONTRAST_FAIL=20
MIN_CONTRAST_WARNING=35
MAX_CONTRAST_WARNING=90
DARK_PIXEL_THRESHOLD=30
BRIGHT_PIXEL_THRESHOLD=240
MAX_DARK_PIXEL_PERCENT=45
MAX_BRIGHT_PIXEL_PERCENT=35
QUALITY_PASS_SCORE=70
QUALITY_WARNING_SCORE=50
MIN_SUITABLE_ASPECT_RATIO=0.5
MAX_SUITABLE_ASPECT_RATIO=2.0
FACE_CROP_DIRECTORY=storage/temp_face_crops
FACE_DETECTION_MIN_CONFIDENCE=0.60
FACE_MIN_AREA_RATIO=0.15
FACE_MAX_AREA_RATIO=0.85
FACE_MAX_CENTER_OFFSET=0.25
FACE_CROP_PADDING_RATIO=0.18
FACE_MIN_CROP_WIDTH=224
FACE_MIN_CROP_HEIGHT=224
FACE_DETECTION_MAX_FACES=1
FACE_CROP_EXPIRY_MINUTES=30
FACE_EDGE_MARGIN_RATIO=0.03
PREPROCESSED_IMAGE_DIRECTORY=storage/temp_preprocessed_images
MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224
MODEL_INPUT_CHANNELS=3
MODEL_INPUT_COLOUR_SPACE=RGB
PREPROCESS_RESIZE_MODE=letterbox
PREPROCESS_PADDING_MODE=reflect
PREPROCESS_NORMALIZATION_MODE=zero_to_one
PREPROCESS_ENABLE_DENOISE=true
PREPROCESS_DENOISE_STRENGTH=3
PREPROCESS_NOISE_THRESHOLD=4.0
PREPROCESS_ENABLE_CLAHE=false
PREPROCESS_CLAHE_CLIP_LIMIT=1.5
PREPROCESS_CLAHE_GRID_SIZE=8
PREPROCESS_ENABLE_WHITE_BALANCE=false
PREPROCESS_ENABLE_SHARPENING=false
PREPROCESS_ALPHA_BACKGROUND=127
PREPROCESS_UPSCALE_WARNING_FACTOR=1.5
PREPROCESSED_IMAGE_FORMAT=JPEG
PREPROCESSED_JPEG_QUALITY=95
PREPROCESSED_IMAGE_EXPIRY_MINUTES=30
SKIN_TYPE_MODEL_PATH=app/ml/models/skin_type_model.keras
SKIN_TYPE_MODEL_METADATA_PATH=app/ml/models/skin_type_model_metadata.json
SKIN_TYPE_CLASS_MAP_PATH=app/ml/models/class_map.json
SKIN_TYPE_MIN_CONFIDENCE=0.60
SKIN_TYPE_HIGH_CONFIDENCE=0.80
SKIN_TYPE_MIN_MARGIN=0.12
SKIN_CONCERN_MODEL_PATH=app/ml/models/skin_concern_model.keras
SKIN_CONCERN_MODEL_METADATA_PATH=app/ml/models/skin_concern_model_metadata.json
SKIN_CONCERN_LABEL_MAP_PATH=app/ml/models/skin_concern_label_map.json
SKIN_CONCERN_THRESHOLDS_PATH=app/ml/models/skin_concern_thresholds.json
CONCERN_UNCERTAINTY_MARGIN=0.05
CONCERN_MODERATE_SEVERITY_DISTANCE=0.25
CONCERN_PROMINENT_SEVERITY_DISTANCE=0.60
PRODUCT_PRICE_STALE_DAYS=30
PRODUCT_AVAILABILITY_STALE_DAYS=14
PRODUCT_SOURCE_VERIFICATION_STALE_DAYS=90
BUDGET_SOFT_OVERAGE_PERCENT=10
RECOMMENDATION_WEIGHT_SKIN_TYPE=0.25
