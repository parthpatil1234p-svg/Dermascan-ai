RECOMMENDATION_WEIGHT_BRAND=0.04
RECOMMENDATION_WEIGHT_DATA_QUALITY=0.03
RECOMMENDATION_WEIGHT_RATING=0.03
PENALTY_ELIGIBLE_WITH_CAUTION=5
