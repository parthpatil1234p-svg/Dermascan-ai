{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start AI Backend (Port 8000)",
      "type": "shell",
      "command": "py -3.12 -m uvicorn app.main:app --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dermascan"
      }
    },
    {
      "label": "2. Start Live Tunnel",
      "type": "shell",
      "command": "npx localtunnel --port 8000 --subdomain dermascan-parth-api",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dermascan"
      }
    },
    {
      "label": "3. Start Frontend (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dermascan"
      }
    }
  ]
}
